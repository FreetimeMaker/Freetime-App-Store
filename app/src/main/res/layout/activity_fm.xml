<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FM_Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <ImageView
                android:id="@+id/fmLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/fas_logo" />

            <TextView
                android:id="@+id/FM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Donate to Freetime Maker" />

            <Button
                android:id="@+id/fmDonobtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Donate to Freetime Maker" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/GeoWeatherLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/geoweather_logo" />

            <TextView
                android:id="@+id/GeoWeatherText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GeoWeather" />

            <Button
                android:id="@+id/gwInfobtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get more Infos about GeoWeather" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <ImageView
                android:id="@+id/DonoLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/donation_logo"
                android:contentDescription="Donation logo" />

            <TextView
                android:id="@+id/DonoTXT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Donation" />

            <Button
                android:id="@+id/donoInfobtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get more Infos about Donation" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/fasLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/fas_logo" />

            <TextView
                android:id="@+id/fasText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Freetime App Store" />

            <Button
                android:id="@+id/fasInfobtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get more Infos about Freetime App Store" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/backLogo"
                android:layout_width="224dp"
                android:layout_height="160dp"
                android:maxWidth="50dp"
                android:maxHeight="50dp"
                android:src="@drawable/back_btn" />

            <Button
                android:id="@+id/backbtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Go Back to Main Menu" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
