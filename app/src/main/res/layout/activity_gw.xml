<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GW_Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/backbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back_btn" />

        <ImageView
            android:id="@+id/GeoWeatherLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/geoweather_logo" />

        <TextView
            android:id="@+id/GeoWeatherText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GeoWeather" />

        <TextView
            android:id="@+id/GeoWeatherVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 1.0.3" />

        <Button
            android:id="@+id/GWDbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Download GeoWeather" />

        <TextView
            android:id="@+id/GeoWeatherDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GeoWeather is a Simple Weather App that shows you the Weather in the City or Location you provided." />

        <Button
            android:id="@+id/GWDonobtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Donate to the Developer of GeoWeather" />

        <TextView
            android:id="@+id/GeoWeatherDev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Developed by Freetime Maker" />

        <TextView
            android:id="@+id/GeoWeatherPerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permissions: Location, Internet" />

        <Button
            android:id="@+id/GWSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View the Source Code of GeoWeather" />

        <Button
            android:id="@+id/MAOFM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="More Apps by Freetime Maker" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
