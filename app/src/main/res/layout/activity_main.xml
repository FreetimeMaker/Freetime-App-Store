<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/GeoWeatherLogo"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/geoweather_logo" />

        <TextView
            android:id="@+id/GeoWeatherText"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:text="GeoWeather" />

        <Button
            android:id="@+id/gwInfobtn"
            android:layout_width="150dp"
            android:layout_height="75dp"
            android:text="Get more Infos about GeoWeather" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp">

        <ImageView
            android:id="@+id/DonoLogo"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/donation_logo" />

        <TextView
            android:id="@+id/DonationText"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:text="Donation" />

        <Button
            android:id="@+id/donoInfobtn"
            android:layout_width="150dp"
            android:layout_height="75dp"
            android:text="Get more Infos about Donation" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp">

        <ImageView
            android:id="@+id/fasLogo"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/fas_logo" />

        <TextView
            android:id="@+id/fasText"
            android:layout_width="121dp"
            android:layout_height="50dp"
            android:text="Freetime App Store" />

        <Button
            android:id="@+id/fasInfobtn"
            android:layout_width="150dp"
            android:layout_height="100dp"
            android:text="Get more Infos about Freetime App Store" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp">

        <ImageView
            android:id="@+id/ghLogo"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/gh_logo" />

        <TextView
            android:id="@+id/ghText"
            android:layout_width="175dp"
            android:layout_height="50dp"
            android:text="Want to see Your App here?" />

        <Button
            android:id="@+id/ghInfobtn"
            android:layout_width="150dp"
            android:layout_height="100dp"
            android:text="Get more Infos about how to get Your App in here?" />
    </LinearLayout>
    </LinearLayout>
</ScrollView>
