<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FM_Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/fmLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/fas_logo" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/FM"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="Support Freetime Maker" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fmDonobtn"
                android:layout_width="150dp"
                android:layout_height="75dp"
                android:text="Support Freetime Maker" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/GeoWeatherLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/geoweather_logo" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/GeoWeatherText"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="GeoWeather" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gwInfobtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Get more Infos about GeoWeather" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/DonoLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/donation_logo" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/DonoTXT"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="Donation" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/donoInfobtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Get more Infos about Donation" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/fasLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/fas_logo" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/fasText"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="Freetime App Store" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fasInfobtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Get more Infos about Freetime App Store" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/catLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/cat_logo" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/catText"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="Cat Clicker" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/catInfobtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Get more Infos about Cat Clicker" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/plcLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/plc_logo" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/plcText"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="Programming Language Clicker" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/plcInfobtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Get more Infos about Programming Language Clicker" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/plc2Logo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/plc2_logo" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/plc2Text"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="PLC 2.0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/plc2Infobtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Get more Infos about PLC 2.0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/platLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/platformer_logo" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/platText"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="2D Platformer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/platInfobtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Get more Infos about 2D Platformer" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/osLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/os_logo" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/osText"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="OS Clicker" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/osInfobtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Get more Infos about OS Clicker" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cryptoLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/crypto_logo" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ccText"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:text="Crypto Clicker" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cryptoInfobtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Get more Infos about Crypto Clicker" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/back_btn" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="Go Back to the Main Activity" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backbtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Go Back" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
