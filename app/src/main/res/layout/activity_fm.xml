<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FM_Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/GeoWeatherLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/geoweather_logo" />

        <TextView
            android:id="@+id/GeoWeatherText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GeoWeather" />

        <Button
            android:id="@+id/gwInfobtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get more Infos about GeoWeather" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/DonoLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/FAS_logo" />

        <TextView
            android:id="@+id/FASText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FAS" />

        <Button
            android:id="@+id/donoInfobtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get more Infos about FAS" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/fasLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/fas_logo" />

        <TextView
            android:id="@+id/fasText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Freetime App Store" />

        <Button
            android:id="@+id/fasInfobtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get more Infos about Freetime App Store" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/backLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back_btn" />

        <Button
            android:id="@+id/backbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Go Back to Main Menu" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
