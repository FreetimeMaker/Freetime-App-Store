<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CryptoClickerActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <Button
                android:id="@+id/backbtn"
                android:layout_width="150dp"
                android:layout_height="55dp"
                android:src="@drawable/back_btn"
                android:text="@string/backTXTANDbackBTNTXT" />

            <ImageView
                android:id="@+id/CryptoLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/crypto_logo" />

            <TextView
                android:id="@+id/CryptoText"
                android:layout_width="150dp"
                android:layout_height="55dp"
                android:text="@string/ccTXT" />

        </LinearLayout>

        <TextView
            android:layout_marginTop="16dp"
            android:id="@+id/CryptoVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ccVTXT" />

        <Button
            android:layout_marginTop="16dp"
            android:id="@+id/CryptoDbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ccDownBTNTXT" />

        <TextView
            android:layout_marginTop="16dp"
            android:id="@+id/CryptoDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ccDescTXT" />

        <TextView
            android:layout_marginTop="16dp"
            android:id="@+id/CryptoDev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/FMDevTXT" />

        <TextView
            android:layout_marginTop="16dp"
            android:id="@+id/CryptoPerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clickerPermTXT" />

        <Button
            android:layout_marginTop="16dp"
            android:id="@+id/CryptoSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ccSCBTNTXT" />

        <Button
            android:layout_marginTop="16dp"
            android:id="@+id/MAOFM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/MAOFMBTNTXT" />
    </LinearLayout>
</ScrollView>