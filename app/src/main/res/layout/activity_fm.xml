<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FM_Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/fmLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/fas_logo" />

            <TextView
                android:id="@+id/FM"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="Donate to Freetime Maker" />

            <Button
                android:id="@+id/fmDonobtn"
                android:layout_width="150dp"
                android:layout_height="75dp"
                android:text="Donate to Freetime Maker" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/GeoWeatherLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/geoweather_logo" />

            <TextView
                android:id="@+id/GeoWeatherText"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="GeoWeather" />

            <Button
                android:id="@+id/gwInfobtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Get more Infos about GeoWeather" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/DonoLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/donation_logo"
                android:contentDescription="Donation logo" />

            <TextView
                android:id="@+id/DonoTXT"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="Donation" />

            <Button
                android:id="@+id/donoInfobtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Get more Infos about Donation" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/fasLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/fas_logo" />

            <TextView
                android:id="@+id/fasText"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="Freetime App Store" />

            <Button
                android:id="@+id/fasInfobtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Get more Infos about Freetime App Store" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/catLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/cat_logo" />

            <TextView
                android:id="@+id/catText"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="Cat Clicker" />

            <Button
                android:id="@+id/catInfobtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Get more Infos about Cat Clicker" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/plc2Logo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/plc2_logo" />

            <TextView
                android:id="@+id/plc2Text"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="PLC 2.0" />

            <Button
                android:id="@+id/plc2Infobtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Get more Infos about PLC 2.0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backLogo"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/back_btn" />

            <TextView
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="Go Back to Main Menu" />

            <Button
                android:id="@+id/backbtn"
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:text="Go Back to Main Menu" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
